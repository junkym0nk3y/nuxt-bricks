# Persistence: a local PostgreSQL (docker compose up -d in the root of the repository).
# When it is set, /api/bricks/** are served by the local Nitro handlers (the Postgres
# adapter).
NUXT_BRICKS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bricks

# Dev-only proxying of the non-bricks /api/* to the backend of the host project
# (/api/bricks/** is never proxied).
PROXY_URL=

# S3 storage of the media (Yandex Object Storage)
NUXT_BRICKS_S3_ACCESS_KEY_ID=
NUXT_BRICKS_S3_SECRET_ACCESS_KEY=
NUXT_BRICKS_S3_BUCKET=

# Basic Auth for the builder, the preview and the mutating API (defaults: admin /
# change-me)
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
