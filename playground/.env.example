# Persistence: локальный PostgreSQL (docker compose up -d в корне репозитория).
# Если задан — /api/bricks/** обслуживаются локальными Nitro-ручками (Postgres-адаптер).
NUXT_BRICKS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bricks

# Dev-only проксирование не-bricks /api/* на backend host-проекта
# (/api/bricks/** никогда не проксируется).
PROXY_URL=

# S3-хранилище медиа (Yandex Object Storage)
NUXT_BRICKS_S3_ACCESS_KEY_ID=
NUXT_BRICKS_S3_SECRET_ACCESS_KEY=
NUXT_BRICKS_S3_BUCKET=

# Basic Auth для /builder и модифицирующих API (дефолты: admin / change-me)
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
