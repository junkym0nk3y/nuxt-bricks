# Persistence: локальный PostgreSQL (docker compose up -d в корне репозитория).
# Если задан — /api/bricks/** обслуживаются локальными Nitro-ручками (Postgres-адаптер).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bricks

# Proxy-режим: внешний REST backend для /api/* (используется, когда DATABASE_URL не задан;
# при заданном DATABASE_URL проксируются только /api/* вне /api/bricks).
PROXY_URL=

# S3-хранилище медиа (Yandex Object Storage)
YANDEX_STORAGE_ACCESS_KEY_ID=
YANDEX_STORAGE_SECRET_ACCESS_KEY=
YANDEX_STORAGE_BUCKET_NAME=

# Basic Auth для /builder и модифицирующих API (дефолты: admin / change-me)
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
